# PX4 a 100.000 pés: diagrama de contexto final (C4, nível 1) (Figura 3.8.4).
# Cinco colunas, para que todas as setas sigam da esquerda para a direita: regulação, operador,
# sistemas externos que falam com o PX4, o PX4 no centro e o ambiente físico (sensores e
# atuadores, pessoas em solo). Células "vazio" centralizam na vertical os nós isolados.
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 5
grid-gap: 250

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 16}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 16}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 20; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  vazio: {label: ""; width: 300; height: 330; style: {fill: transparent; stroke: transparent}}
  pessoa: {shape: image; style.font-size: 17}
  sistema: {width: 300; height: 200; label.near: top-center; icon.near: bottom-center; style: {fill: "#1A2E4A"; stroke: "#1A2E4A"; font-color: "#FFFFFF"; font-size: 20; bold: true; border-radius: 10}}
  externo: {width: 250; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17; border-radius: 6}}
}

regulacao: {
  class: livre
  grid-rows: 3
  grid-gap: 0
  topo: {class: vazio; width: 250; height: 190}
  reg: "Regulação\nANAC, DECEA" {class: externo; icon: https://icons.terrastruct.com/essentials%2F170-flag.svg}
  base: {class: vazio; width: 250; height: 190}
}

pessoas: "Pessoas" {
  class: faixa
  grid-rows: 3
  grid-gap: 0
  topo: {class: vazio; width: 150; height: 150}
  operador: "Operador\npiloto remoto" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F365-user.svg}
  base: {class: vazio; width: 150; height: 150}
}

externos: "Sistemas externos" {
  class: faixa
  grid-rows: 3
  grid-gap: 60
  rc: "Rádio controle\nsistema externo" {class: externo; icon: https://icons.terrastruct.com/tech%2F041-joystick.svg}
  gcs: "Estação em solo\nQGroundControl" {class: externo; icon: https://icons.terrastruct.com/tech%2Flaptop.svg}
  cc: "Computador de missão\nLinux e ROS 2" {class: externo; icon: https://icons.terrastruct.com/aws%2FRobotics%2FAWS-RoboMaker_Cloud-Extension-ROS_light-bg.svg}
}

centro: {
  class: livre
  grid-rows: 3
  grid-gap: 0
  topo: {class: vazio; height: 155}
  px4: "Piloto automático PX4\nsoftware de voo embarcado" {class: sistema; icon: https://icons.terrastruct.com/tech%2F014-cpu.svg}
  base: {class: vazio; height: 155}
}

fisico: "Ambiente físico" {
  class: faixa
  grid-rows: 2
  grid-gap: 90
  hw: "Sensores e atuadores\nIMUs redundantes, GNSS,\nbarômetro, ESCs, servos" {class: externo; height: 150; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Sensor_light-bg.svg}
  solo: "Pessoas em solo" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F359-users.svg}
}

regulacao.reg -> pessoas.operador: "restringe a operação" {class: sinc}
pessoas.operador -> externos.rc: "comandos manuais" {class: sinc}
externos.rc -> centro.px4: "sinais de controle" {class: sinc}
pessoas.operador -> externos.gcs: "planeja missões, monitora" {class: sinc}
externos.gcs -> centro.px4: "MAVLink" {class: assinc}
externos.cc -> centro.px4: "uXRCE-DDS ou MAVLink\nmodos externos não críticos" {class: assinc}
centro.px4 -> fisico.hw: "lê e comanda" {class: sinc}
centro.px4 -> fisico.solo: "risco físico" {class: sinc}
