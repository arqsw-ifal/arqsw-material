# Projeto de referência de Xu (2020, cap. 15) para um serviço do tipo Google Drive (Figura 4.5.1).
# Figura adaptada de Xu: sem passos numerados; rótulos curtos de papel.
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 4
grid-gap: 110

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 16}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 16}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  host: {style: {fill: "#E8EDF4"; stroke: "#1A2E4A"; stroke-width: 3; border-radius: 4; font-size: 22; bold: true}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 20; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 190; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17; border-radius: 6}}
}

clientes: "Clientes" {
  class: faixa
  grid-rows: 3
  grid-gap: 60
  topo: {class: livre; width: 110; height: 110}
  c: "Clientes\nweb, desktop, móvel" {icon: https://icons.terrastruct.com/tech%2Flaptop.svg; shape: image; width: 110; height: 110; style.font-size: 18}
  base: {class: livre; width: 110; height: 110}
}

borda: "Borda" {
  class: faixa
  grid-rows: 3
  grid-gap: 60
  lb: "Balanceador\nde carga" {class: no; icon: https://icons.terrastruct.com/aws%2FNetworking%20%26%20Content%20Delivery%2FElastic-Load-Balancing.svg}
  v1: {class: livre; width: 230; height: 130}
  v2: {class: livre; width: 230; height: 130}
}

app: "Aplicação" {
  class: faixa
  grid-rows: 3
  grid-gap: 60
  api: "Servidores de API\nautenticação, metadados" {class: no; icon: https://icons.terrastruct.com/aws%2FCompute%2FAmazon-EC2.svg}
  ns: "Serviço de\nnotificação" {class: no; icon: https://icons.terrastruct.com/aws%2FApplication%20Integration%2FAmazon-Simple-Notification-Service-SNS.svg}
  bs: "Servidores de blocos\ndivide, comprime, cifra" {class: no; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Batch.svg}
}

dados: "Dados" {
  class: faixa
  grid-columns: 2
  vertical-gap: 60
  horizontal-gap: 170
  mc: "Cache de\nmetadados" {class: banco; icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-ElastiCache.svg}
  q: "Fila de backup\noffline" {class: banco; icon: https://icons.terrastruct.com/aws%2FApplication%20Integration%2FAmazon-Simple-Queue-Service-SQS.svg}
  cs: "Armazenamento\nde blocos" {class: banco; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg}
  mdb: "Banco de\nmetadados" {class: banco; icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-RDS.svg}
  vazio: {class: livre; width: 230; height: 190}
  cold: "Armazenamento\nfrio" {class: banco; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-S3-Glacier.svg}
}

clientes.c -> borda.lb {class: sinc}
borda.lb -> app.api {class: sinc}
clientes.c -> app.bs {class: sinc}
app.bs -> dados.cs {class: sinc}
dados.cs -> dados.cold: "move dados\ninativos" {class: sinc}
app.api -> dados.mc {class: sinc}
dados.mc -> dados.mdb {class: sinc}
app.api -> app.ns {class: assinc}
app.ns -> clientes.c: "long polling" {class: assinc}
app.api -> dados.q {class: assinc}
