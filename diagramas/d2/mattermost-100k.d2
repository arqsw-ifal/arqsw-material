# Mattermost a 100.000 pés: diagrama de contexto final (C4, nível 1) (Figura 3.3.4).
# Diagrama de contexto: pessoas à esquerda, o sistema no centro, sistemas externos à direita.
# Membro de equipe e APNs/FCM ficam na base das faixas, abaixo do sistema, para que a entrega
# ao celular volte à pessoa sem cruzar a caixa do sistema.
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 3
grid-gap: 320

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 16}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 16}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 20; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  vazio: {label: ""; width: 300; height: 330; style: {fill: transparent; stroke: transparent}}
  pessoa: {shape: image; style.font-size: 17}
  sistema: {width: 300; height: 200; label.near: top-center; icon.near: bottom-center; style: {fill: "#1A2E4A"; stroke: "#1A2E4A"; font-color: "#FFFFFF"; font-size: 20; bold: true; border-radius: 10}}
  externo: {width: 250; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17; border-radius: 6}}
}

pessoas: "Pessoas" {
  class: faixa
  grid-rows: 3
  grid-gap: 90
  dev: "Desenvolvedor de integrações\nbots, webhooks, plugins" {class: pessoa; icon: https://icons.terrastruct.com/tech%2Flaptop.svg}
  admin: "Administrador e corregedoria\noperação e conformidade" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F204-settings.svg}
  membro: "Membro de equipe\nweb, desktop e celular" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F359-users.svg}
}

centro: {
  class: livre
  grid-rows: 3
  grid-gap: 0
  topo: {class: vazio}
  mm: "Mattermost\ninfraestrutura própria do órgão" {class: sistema; icon: https://icons.terrastruct.com/dev%2Fgo.svg}
  base: {class: vazio}
}

externos: "Sistemas externos" {
  class: faixa
  grid-rows: 4
  grid-gap: 75
  idp: "Diretório corporativo\nLDAP, SAML, OpenID" {class: externo; icon: https://icons.terrastruct.com/aws%2FSecurity%2C%20Identity%2C%20%26%20Compliance%2FAWS-Directory-Service.svg}
  ext: "Sistemas externos\nmonitoramento, chamados" {class: externo; icon: https://icons.terrastruct.com/essentials%2F226-alarm%20clock.svg}
  push: "Serviço de push\nHPNS ou proxy próprio" {class: externo; icon: https://icons.terrastruct.com/aws%2FApplication%20Integration%2FAmazon-Simple-Notification-Service-SNS.svg}
  apns: "APNs e FCM\nApple e Google" {class: externo; icon: https://icons.terrastruct.com/tech%2Fantenna.svg}
}

pessoas.membro -> centro.mm: "envia e recebe mensagens" {class: sinc}
pessoas.admin -> centro.mm: "configura, audita, exporta" {class: sinc}
pessoas.dev -> centro.mm: "estende" {class: sinc}
centro.mm -> externos.idp: "autentica usuários" {class: sinc}
centro.mm <-> externos.ext: "webhooks de entrada\ne de saída, comandos" {class: sinc}
centro.mm -> externos.push: "solicita notificação" {class: assinc}
externos.push -> externos.apns: "encaminha" {class: assinc}
externos.apns -> pessoas.membro: "entrega ao celular" {class: assinc}
