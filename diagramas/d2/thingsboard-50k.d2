# ThingsBoard a 50.000 pés: containers e fluxo de uma telemetria (estilo de Xu, 2020).
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
# Setas numeradas: passos do fluxo, descritos no texto abaixo da figura.
# Faixas extras: "Transportes" e "Fila", porque o Kafka fica entre os transportes e o motor de regras.
# Nós "vazio" são espaçadores invisíveis que alinham as linhas da grade entre as faixas.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 6
grid-gap: 110

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 24; bold: true}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 24; bold: true}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 22; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  vazio: {label: ""; width: 230; height: 130; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 190; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18; border-radius: 6}}
}

externos: {
  class: livre
  grid-rows: 4
  vertical-gap: 100
  horizontal-gap: 20
  dev: "Dispositivos" {icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Sensor_light-bg.svg; shape: image; width: 90; height: 90; style.font-size: 18}
  v1: {class: vazio}
  v2: {class: vazio}
  usr: "Usuários" {icon: https://icons.terrastruct.com/essentials%2F359-users.svg; shape: image; width: 90; height: 90; style.font-size: 18}
}

borda: "Borda" {
  class: faixa
  grid-rows: 4
  vertical-gap: 130
  horizontal-gap: 40
  lb: "Balanceador\nHAProxy" {class: no; icon: https://icons.terrastruct.com/tech%2Frouter.svg}
  v1: {class: vazio}
  v2: {class: vazio}
  ui: "tb-web-ui" {class: no; icon: https://icons.terrastruct.com/tech%2Fbrowser-2.svg}
}

transp: "Transportes" {
  class: faixa
  grid-rows: 4
  vertical-gap: 130
  horizontal-gap: 40
  mqtt: "tb-mqtt-transport" {class: no; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_MQTT-protocol_light-bg.svg}
  coap: "tb-coap-transport" {class: no; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Generic_light-bg.svg}
  http: "tb-http-transport" {class: no; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_HTTP-protocol_light-bg.svg}
  v1: {class: vazio}
}

fila: "Fila" {
  class: faixa
  grid-rows: 4
  vertical-gap: 100
  horizontal-gap: 40
  v1: {class: vazio}
  kafka: "Kafka\ntópicos particionados" {class: banco; icon: https://icons.terrastruct.com/aws%2FAnalytics%2FAmazon-Managed-Streaming-for-Kafka.svg}
  v2: {class: vazio}
  v3: {class: vazio}
}

app: "Aplicação" {
  class: faixa
  grid-rows: 4
  vertical-gap: 130
  horizontal-gap: 40
  re: "tb-rule-engine\nmotor de regras" {class: no; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Rule_light-bg.svg}
  js: "tb-js-executor\nscripts em Node.js" {class: no; icon: https://icons.terrastruct.com/dev%2Fnodejs.svg}
  core: "tb-core\nREST · WebSocket · atores" {class: no; icon: https://icons.terrastruct.com/dev%2Fjava.svg}
  v1: {class: vazio}
}

dados: "Dados" {
  class: faixa
  grid-rows: 4
  vertical-gap: 70
  horizontal-gap: 40
  ts: "Séries temporais\nCassandra ou TimescaleDB" {class: banco; icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-Managed-Apache-Cassandra-Service.svg}
  pg: "PostgreSQL\nentidades e alarmes" {class: banco; icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg}
  valkey: "Valkey\ncache" {class: banco; icon: https://icons.terrastruct.com/dev%2Fredis.svg}
  zk: "Zookeeper\ncoordenação" {class: no; icon: https://icons.terrastruct.com/essentials%2F204-settings.svg}
}

externos.dev -> borda.lb: "1" {class: sinc}
borda.lb -> transp.mqtt: "2" {class: sinc}
transp.mqtt -> fila.kafka: "3, 6" {class: assinc}
fila.kafka -> app.core: "4, 12" {class: assinc}
app.core -> dados.valkey: "5" {class: sinc}
fila.kafka <-> app.re: "7, 9, 12" {class: assinc}
app.re -> dados.ts: "8" {class: sinc}
fila.kafka -> app.js: "10" {class: assinc}
app.re -> dados.pg: "11" {class: sinc}
app.core <-> borda.ui: "13" {class: assinc}
borda.ui <-> externos.usr: "13" {class: assinc}
borda.lb -> transp.coap {class: apoio}
borda.lb -> transp.http {class: apoio}
transp.coap -> fila.kafka {class: apoio}
transp.http -> fila.kafka {class: apoio}
app.core -> dados.pg {class: apoio}
# O Zookeeper coordena os serviços da faixa (tb-rule-engine e tb-core): uma única seta para a faixa.
dados.zk -> app {class: apoio}
