# Nextcloud a 50.000 pés: implantação com vários servidores de aplicação (Figura 4.5.4).
# Diagrama de implantação: sem passos numerados; rótulos curtos de protocolo ou papel.
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
# Réplicas: as setas para Redis, banco e objetos partem do servidor 1; as dos servidores 2 e 3
# são `apoio`, para não poluir a figura (regra "Réplicas" do README).
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 3
grid-gap: 160

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 16}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 16}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  host: {style: {fill: "#E8EDF4"; stroke: "#1A2E4A"; stroke-width: 3; border-radius: 4; font-size: 22; bold: true}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 20; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 160; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17; border-radius: 6}}
}

borda: "Borda" {
  class: faixa
  grid-rows: 3
  grid-gap: 60
  v1: {class: livre; width: 230; height: 130}
  lb: "Balanceador de carga\nTLS" {class: no; icon: https://icons.terrastruct.com/aws%2FNetworking%20%26%20Content%20Delivery%2FElastic-Load-Balancing.svg}
  v2: {class: livre; width: 230; height: 130}
}

app: "Aplicação" {
  class: faixa
  grid-rows: 3
  grid-gap: 60
  np: "notify_push" {class: no; icon: https://icons.terrastruct.com/dev%2Frust.svg}
  srv: "Servidores de aplicação" {
    class: host
    grid-rows: 3
    grid-gap: 80
    a1: "Web + PHP-FPM 1\nAPCu local" {class: no; icon: https://icons.terrastruct.com/dev%2Fphp.svg}
    a2: "Web + PHP-FPM 2\nAPCu local" {class: no; icon: https://icons.terrastruct.com/dev%2Fphp.svg}
    a3: "Web + PHP-FPM 3\nAPCu local" {class: no; icon: https://icons.terrastruct.com/dev%2Fphp.svg}
  }
  cr: "Nó de tarefas\ncron a cada 5 min" {class: no; icon: https://icons.terrastruct.com/essentials%2F226-alarm%20clock.svg}
}

dados: "Dados" {
  class: faixa
  grid-rows: 3
  grid-gap: 90
  rd: "Redis\ncache distribuído\ne locks" {class: banco; height: 230; icon: https://icons.terrastruct.com/dev%2Fredis.svg}
  db: "Banco relacional\nprimário + réplica" {class: banco; height: 190; icon: https://icons.terrastruct.com/essentials%2F117-database.svg}
  obj: "Armazenamento de\nobjetos: S3 do\ncentro de dados" {class: banco; height: 230; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg}
}

borda.lb -> app.srv.a1 {class: sinc}
borda.lb -> app.srv.a2 {class: sinc}
borda.lb -> app.srv.a3 {class: sinc}
borda.lb -> app.np: "WebSocket" {class: assinc}
app.np -> dados.rd: "eventos" {class: assinc}
app.srv.a1 -> dados.rd {class: sinc}
app.srv.a1 -> dados.db {class: sinc}
app.srv.a1 -> dados.obj {class: sinc}
app.srv.a2 -> dados.rd {class: apoio}
app.srv.a2 -> dados.db {class: apoio}
app.srv.a2 -> dados.obj {class: apoio}
app.srv.a3 -> dados.rd {class: apoio}
app.srv.a3 -> dados.db {class: apoio}
app.srv.a3 -> dados.obj {class: apoio}
app.cr -> dados.db {class: sinc}
app.cr -> dados.obj {class: sinc}
