# PeerTube a 50.000 pés: implantação de referência com Docker Compose em um único host (Figura 4.4.2).
# Diagrama de implantação: sem passos numerados; rótulos curtos de protocolo, porta ou papel.
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
# Linhas vazias (sp*) da grade deixam passar as setas sem cruzar as caixas.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 3
grid-gap: 80

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 16}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 16}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  host: {style: {fill: "#E8EDF4"; stroke: "#1A2E4A"; stroke-width: 3; border-radius: 4; font-size: 22; bold: true}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 20; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 160; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17; border-radius: 6}}
}

externo: {
  class: livre
  grid-rows: 5
  grid-gap: 60
  t: {class: livre; width: 90; height: 10}
  lab: "Runners remotos\noutros hosts" {icon: https://icons.terrastruct.com/tech%2Fservers.svg; shape: image; width: 90; height: 90; style.font-size: 18}
  internet: "Internet: espectadores,\ncriadores, instâncias" {icon: https://icons.terrastruct.com/essentials%2F140-internet.svg; shape: image; width: 90; height: 90; style.font-size: 18}
  sp: {class: livre; width: 90; height: 260}
  rtmp: "Internet: transmissões\nao vivo" {icon: https://icons.terrastruct.com/essentials%2F140-internet.svg; shape: image; width: 90; height: 90; style.font-size: 18}
}

host: "Host Docker da instância" {
  class: host
  icon: https://icons.terrastruct.com/dev%2Fdocker.svg
  icon.near: top-left
  grid-columns: 3
  grid-gap: 100

  borda: "Borda" {
    class: faixa
    grid-rows: 4
    grid-gap: 60
    cert: "certbot\nrenova certificados" {class: no; height: 160; icon: https://icons.terrastruct.com/aws%2FSecurity%2C%20Identity%2C%20%26%20Compliance%2FAWS-Certificate-Manager.svg}
    web: "webserver: NGINX\nportas 80 e 443" {class: no; height: 160; icon: https://icons.terrastruct.com/dev%2Fnginx.svg}
    rel: "webserver-reloader\nrecarga a cada 6 h" {class: no; height: 160; icon: https://icons.terrastruct.com/essentials%2F226-alarm%20clock.svg}
    sp: {class: livre; width: 230; height: 160}
  }

  app: "Aplicação" {
    class: faixa
    grid-rows: 4
    grid-gap: 60
    pf: "postfix\nrelay de e-mail" {class: no; height: 160; icon: https://icons.terrastruct.com/aws%2FCustomer%20Engagement%2FAmazon-Simple-Email-Service-SES.svg}
    sp1: {class: livre; width: 230; height: 160}
    sp2: {class: livre; width: 230; height: 160}
    pt: "peertube: Node.js\n9000 interna;\n1935 RTMP publicada" {class: no; height: 160; icon: https://icons.terrastruct.com/dev%2Fnodejs.svg}
  }

  dados: "Dados" {
    class: faixa
    grid-rows: 4
    grid-gap: 60
    pg: "postgres 17" {class: banco; height: 160; icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg}
    vol: "volume docker-volume/data\nvídeos, playlists,\nminiaturas" {class: banco; height: 220; width: 260; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Elastic-Block-Store-EBS.svg}
    rd: "redis 8" {class: banco; height: 160; icon: https://icons.terrastruct.com/dev%2Fredis.svg}
    sp: {class: livre; width: 230; height: 160}
  }
}

nuvem: {
  class: livre
  grid-rows: 4
  grid-gap: 60
  sp1: {class: livre; width: 230; height: 160}
  sp2: {class: livre; width: 230; height: 160}
  sp3: {class: livre; width: 230; height: 160}
  s3: "Armazenamento de\nobjetos S3\nopcional, externo" {class: banco; height: 220; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg}
}

externo.internet -> host.borda.web {class: sinc}
externo.rtmp -> host.app.pt: "RTMP ao vivo" {class: sinc}
externo.lab -> host.borda.web: "HTTPS" {class: sinc}
host.borda.web -> host.app.pt: "proxy da API" {class: sinc}
host.borda.web -> host.dados.vol: "lê arquivos estáticos" {class: sinc}
host.app.pt -> host.dados.pg {class: sinc}
host.app.pt -> host.dados.rd {class: sinc}
host.app.pt -> host.app.pf {class: sinc}
host.app.pt -> host.dados.vol {class: sinc}
host.app.pt -> nuvem.s3: "(opcional)" {class: sinc}
host.borda.rel -> host.borda.web: "recarrega a configuração" {class: sinc}
host.borda.cert -> host.borda.web: "fornece certificados" {class: sinc}
