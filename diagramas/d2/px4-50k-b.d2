# PX4 a 50.000 pés, parte (b): enlaces com o solo e com o computador de missão (estilo de Xu, 2020).
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
# Setas numeradas: passos 9 a 14 do fluxo, continuando a parte (a), px4-50k-a.d2.
# O núcleo do firmware (módulos internos e barramento uORB) aparece como um único nó;
# só os adaptadores externos mavlink e uxrce_dds_client ficam visíveis.
# Nós "vazio" são espaçadores invisíveis que alinham as linhas da grade.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 4
grid-gap: 110

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 24; bold: true}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 24; bold: true}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 22; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  vazio: {label: ""; width: 230; height: 130; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 190; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18; border-radius: 6}}
}

solo: "Solo" {
  class: faixa
  qgc: "QGroundControl\nestação em solo" {class: no; icon: https://icons.terrastruct.com/tech%2Flaptop.svg}
}

meio: {
  class: livre
  grid-rows: 2
  vertical-gap: 60
  enlace: "Enlace" {
    class: faixa
    radio: "Rádio de telemetria" {class: no; icon: https://icons.terrastruct.com/tech%2Fantenna.svg}
  }
  hw: "Sensores e atuadores" {
    class: faixa
    rc: "Receptor de\nrádio controle" {class: no; icon: https://icons.terrastruct.com/tech%2F041-joystick.svg}
  }
}

fc: "Controlador de voo" {
  class: faixa
  grid-rows: 3
  vertical-gap: 100
  mavlink: "mavlink\nadaptador externo" {class: no; icon: https://icons.terrastruct.com/essentials%2F103-wireless%20internet.svg}
  px4: "Firmware PX4\nmódulos e uORB" {class: no; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Topic_light-bg.svg}
  dds: "uxrce_dds_client\nponte para o ROS 2" {class: no; icon: https://icons.terrastruct.com/infra%2F013-transfer.svg}
}

missao: "Computador de missão · Linux" {
  class: faixa
  grid-rows: 3
  vertical-gap: 100
  v1: {class: vazio}
  ros: "Aplicações ROS 2\nvisão, modos externos" {class: no; icon: https://icons.terrastruct.com/aws%2FRobotics%2FAWS-RoboMaker_Cloud-Extension-ROS_light-bg.svg}
  agente: "Agente\nMicro XRCE-DDS" {class: no; icon: https://icons.terrastruct.com/essentials%2F092-network.svg}
}

fc.px4 -> fc.mavlink: "9" {class: assinc}
fc.mavlink -> meio.enlace.radio: "10" {class: assinc}
meio.enlace.radio -> solo.qgc: "11" {class: assinc}
fc.px4 <-> fc.dds: "12" {class: assinc}
fc.dds <-> missao.agente: "13" {class: assinc}
missao.agente <-> missao.ros: "14" {class: assinc}
meio.hw.rc -> fc.px4 {class: apoio}
