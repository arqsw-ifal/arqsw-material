# PeerTube a 100.000 pés: diagrama de contexto final (C4, nível 1) (Figura 3.4.5).
# Diagrama de contexto: pessoas à esquerda, o sistema no centro, sistemas externos à direita.
# Os runners atuam como clientes (pedem tarefas por HTTP) e por isso ficam à esquerda.
# Estudante e outros estudantes ficam adjacentes, ligados pela troca de segmentos via WebRTC.
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 3
grid-gap: 320

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 16}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 16}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 20; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  vazio: {label: ""; width: 300; height: 330; style: {fill: transparent; stroke: transparent}}
  pessoa: {shape: image; style.font-size: 17}
  sistema: {width: 300; height: 200; label.near: top-center; icon.near: bottom-center; style: {fill: "#1A2E4A"; stroke: "#1A2E4A"; font-color: "#FFFFFF"; font-size: 20; bold: true; border-radius: 10}}
  externo: {width: 250; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17; border-radius: 6}}
}

pessoas: "Pessoas" {
  class: faixa
  grid-rows: 5
  vertical-gap: 80
  est2: "Outros estudantes\npares WebRTC" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F359-users.svg}
  est: "Estudante\nassiste e comenta" {class: pessoa; icon: https://icons.terrastruct.com/tech%2Fbrowser-2.svg}
  prof: "Professor\nenvia videoaulas" {class: pessoa; icon: https://icons.terrastruct.com/tech%2Flaptop.svg}
  admin: "Administrador\nconfigura e modera" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F204-settings.svg}
  runner: "Runners\nestações do laboratório" {class: pessoa; icon: https://icons.terrastruct.com/tech%2Fservers.svg}
}

centro: {
  class: livre
  grid-rows: 3
  grid-gap: 0
  topo: {class: vazio; height: 540}
  pt: "Instância PeerTube\npublica, processa e entrega vídeos" {class: sistema; width: 360; icon: https://icons.terrastruct.com/essentials%2F002-video%20player.svg}
  base: {class: vazio; height: 540}
}

externos: "Sistemas externos" {
  class: faixa
  grid-rows: 4
  vertical-gap: 150
  idp: "Provedor de identidade\nlogin institucional" {class: externo; icon: https://icons.terrastruct.com/aws%2FSecurity%2C%20Identity%2C%20%26%20Compliance%2FAWS-Directory-Service.svg}
  mail: "Servidor de e-mail" {class: externo; icon: https://icons.terrastruct.com/aws%2FCustomer%20Engagement%2FAmazon-Simple-Email-Service-SES.svg}
  outras: "Instâncias parceiras\nfediverso" {class: externo; icon: https://icons.terrastruct.com/essentials%2F092-network.svg}
  s3: "Armazenamento de objetos\nS3 da TI central" {class: externo; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg}
}

pessoas.prof -> centro.pt: "envio retomável" {class: sinc}
pessoas.est -> centro.pt: "API REST, HLS por HTTP" {class: sinc}
pessoas.est <-> pessoas.est2: "segmentos via WebRTC" {class: sinc}
pessoas.admin -> centro.pt: "configuração e moderação" {class: sinc}
centro.pt -> externos.idp: "autentica via plugin" {class: sinc}
centro.pt -> externos.mail: "notificações" {class: sinc}
centro.pt <-> externos.outras: "ActivityPub assinado" {class: assinc}
pessoas.runner -> centro.pt: "pede tarefas por HTTP" {class: sinc}
centro.pt -> externos.s3: "grava e serve arquivos" {class: sinc}
