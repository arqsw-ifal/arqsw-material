# Nextcloud a 50.000 pés: containers e fluxo de envio e sincronização de um arquivo (estilo de Xu, 2020).
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
# Setas numeradas: passos do fluxo, descritos no texto abaixo da figura.
# A figura original não tem proxy reverso; por isso a grade tem três colunas, sem a faixa "Borda".
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 3
grid-gap: 150

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 24; bold: true}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 24; bold: true}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 22; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 160; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18; border-radius: 6}}
}

usuarios: {
  class: livre
  grid-rows: 3
  grid-gap: 70
  desk: "Cliente desktop\nC++/Qt, sincronização" {icon: https://icons.terrastruct.com/tech%2Fdesktop.svg; shape: image; width: 110; height: 110; style.font-size: 18}
  web: "Navegador\ninterface web" {icon: https://icons.terrastruct.com/tech%2Fbrowser-2.svg; shape: image; width: 110; height: 110; style.font-size: 18}
  mob: "Apps móveis" {icon: https://icons.terrastruct.com/tech%2F052-smartphone-3.svg; shape: image; width: 110; height: 110; style.font-size: 18}
}

app: "Aplicação" {
  class: faixa
  grid-rows: 4
  grid-gap: 50
  push: "notify_push\nopcional, WebSocket" {class: no; icon: https://icons.terrastruct.com/dev%2Frust.svg}
  php: "Aplicação PHP\nnúcleo + apps" {class: no; icon: https://icons.terrastruct.com/dev%2Fphp.svg}
  vao: {class: livre; width: 230; height: 90}
  cron: "Tarefas em segundo\nplano: cron.php" {class: no; icon: https://icons.terrastruct.com/essentials%2F226-alarm%20clock.svg}
}

dados: "Dados" {
  class: faixa
  grid-rows: 3
  grid-gap: 50
  redis: "Redis\ncache e locking" {class: banco; height: 200; icon: https://icons.terrastruct.com/dev%2Fredis.svg}
  stor: "Armazenamento primário\ndisco ou objetos" {class: no; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg}
  db: "Banco relacional\nMariaDB, MySQL\nou PostgreSQL" {class: banco; height: 230; icon: https://icons.terrastruct.com/essentials%2F117-database.svg}
}

usuarios.desk -> app.php: "1, 7" {class: sinc}
app.php -> dados.redis: "2" {class: sinc}
app.php -> dados.stor: "3" {class: sinc}
app.php -> dados.db: "4" {class: sinc}
app.push -> dados.redis: "5" {class: assinc}
app.push -> usuarios.desk: "6" {class: assinc}
usuarios.web -> app.php {class: apoio}
usuarios.mob -> app.php {class: apoio}
app.cron -> dados.db {class: apoio}
app.cron -> dados.stor {class: apoio}
