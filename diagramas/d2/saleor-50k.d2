# Saleor a 50.000 pés: containers e fluxo de um checkout (estilo de Xu, 2020).
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
# Setas numeradas: passos do fluxo, descritos no texto abaixo da figura.
# O Saleor não tem container de borda na Figura 4.6.1; por isso a grade tem três colunas:
# clientes e apps externas, aplicação e dados.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 3
grid-gap: 230

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 24; bold: true}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 24; bold: true}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 22; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 190; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18; border-radius: 6}}
}

externos: {
  class: livre
  grid-rows: 5
  grid-gap: 40
  dashboard: "Saleor Dashboard\naplicação de página única" {icon: https://icons.terrastruct.com/essentials%2F001-analytics.svg; shape: image; width: 90; height: 90; style.font-size: 18}
  vitrine: "Vitrine\nprojeto separado" {icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Cart_light-bg.svg; shape: image; width: 90; height: 90; style.font-size: 18}
  pagamento: "App de pagamento" {icon: https://icons.terrastruct.com/essentials%2Fsalary.svg; shape: image; width: 90; height: 90; style.font-size: 18}
  frete: "Apps de frete\ne impostos" {icon: https://icons.terrastruct.com/infra%2F013-transfer.svg; shape: image; width: 90; height: 90; style.font-size: 18}
  fiscal: "App fiscal" {icon: https://icons.terrastruct.com/essentials%2F263-notepad.svg; shape: image; width: 90; height: 90; style.font-size: 18}
}

app: "Aplicação · uma imagem" {
  class: faixa
  grid-rows: 3
  vertical-gap: 130
  horizontal-gap: 40
  api: "API GraphQL\nDjango · Graphene · Uvicorn" {class: no; icon: https://icons.terrastruct.com/dev%2Fdjango.svg}
  workers: "Workers Celery\ntarefas e webhooks" {class: no; icon: https://icons.terrastruct.com/dev%2Fpython.svg}
  beat: "Celery beat\ntarefas agendadas" {class: no; icon: https://icons.terrastruct.com/essentials%2F226-alarm%20clock.svg}
}

dados: "Dados" {
  class: faixa
  grid-rows: 2
  vertical-gap: 190
  horizontal-gap: 40
  pg: "PostgreSQL\nprimário e réplica" {class: banco; icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg}
  broker: "Broker e cache\nRedis/Valkey ou SQS" {class: banco; icon: https://icons.terrastruct.com/dev%2Fredis.svg}
}

externos.vitrine -> app.api: "1, 4, 7" {class: sinc}
app.api -> externos.frete: "2, 3" {class: sinc}
app.api -> externos.pagamento: "5" {class: sinc}
app.api -> dados.pg: "6, 8" {class: sinc}
app.api -> dados.broker: "9" {class: assinc}
dados.broker -> app.workers: "10" {class: assinc}
app.workers -> externos.fiscal: "11" {class: assinc}
externos.dashboard -> app.api {class: apoio}
externos.fiscal -> app.api {class: apoio}
app.workers -> dados.pg {class: apoio}
app.beat -> dados.broker {class: apoio}
