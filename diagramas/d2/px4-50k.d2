# PX4 a 50.000 pés: containers e fluxo de um ciclo de controle (estilo de Xu, 2020).
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona (no controlador de voo, tópicos uORB).
# Setas numeradas: passos do fluxo, descritos no texto abaixo da figura.
# Faixas adaptadas ao sistema embarcado: Solo | Enlace e computador de missão | Controlador de voo | Sensores e atuadores.
# O container "Firmware PX4" é aberto em seus módulos principais, ligados ao barramento uORB.
# Nós "vazio" são espaçadores invisíveis que alinham as linhas da grade entre as faixas.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 4
grid-gap: 110

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 24; bold: true}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 24; bold: true}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 22; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  vazio: {label: ""; width: 230; height: 130; style: {fill: transparent; stroke: transparent}}
  banco: {width: 230; height: 190; shape: cylinder; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18}}
  no: {width: 230; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 18; border-radius: 6}}
}

solo: "Solo" {
  class: faixa
  grid-rows: 3
  vertical-gap: 110
  horizontal-gap: 40
  qgc: "QGroundControl\nestação em solo" {class: no; icon: https://icons.terrastruct.com/tech%2Flaptop.svg}
  v1: {class: vazio}
  v2: {class: vazio}
}

meio: {
  class: livre
  grid-rows: 2
  vertical-gap: 20
  enlace: "Enlace" {
    class: faixa
    radio: "Rádio de telemetria" {class: no; icon: https://icons.terrastruct.com/tech%2Fantenna.svg}
  }
  missao: "Computador de missão · Linux" {
    class: faixa
    grid-rows: 2
    vertical-gap: 90
    agente: "Agente\nMicro XRCE-DDS" {class: no; icon: https://icons.terrastruct.com/essentials%2F092-network.svg}
    ros: "Aplicações ROS 2\nvisão, modos externos" {class: no; icon: https://icons.terrastruct.com/aws%2FRobotics%2FAWS-RoboMaker_Cloud-Extension-ROS_light-bg.svg}
  }
}

fc: "Controlador de voo · NuttX · firmware PX4" {
  class: faixa
  grid-columns: 3
  horizontal-gap: 160
  vertical-gap: 100
  # A grade preenche coluna a coluna: mavlink, uxrce_dds_client e logger formam a coluna da esquerda.
  mavlink: "mavlink\nadaptador externo" {class: no; icon: https://icons.terrastruct.com/essentials%2F103-wireless%20internet.svg}
  dds: "uxrce_dds_client\nponte para o ROS 2" {class: no; icon: https://icons.terrastruct.com/infra%2F013-transfer.svg}
  logger: "logger e dataman" {class: no; icon: https://icons.terrastruct.com/essentials%2F263-notepad.svg}
  ekf2: "ekf2\nestimador" {class: no; icon: https://icons.terrastruct.com/essentials%2F142-target.svg}
  uorb: "uORB\npublish/subscribe" {class: no; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Topic_light-bg.svg}
  sd: "Cartão SD\nlogs · parâmetros · missões" {class: banco; icon: https://icons.terrastruct.com/tech%2Fdiskette.svg}
  entrada: "Drivers de entrada\nsensores e RC" {class: no; icon: https://icons.terrastruct.com/tech%2F014-cpu.svg}
  ctrl: "Controladores\ne alocação de controle" {class: no; icon: https://icons.terrastruct.com/essentials%2F178-controls.svg}
  saida: "Drivers de saída\nPWM · DShot · CAN" {class: no; icon: https://icons.terrastruct.com/tech%2F012-cpu-2.svg}
}

hw: "Sensores e atuadores" {
  class: faixa
  grid-rows: 3
  vertical-gap: 110
  horizontal-gap: 40
  imu: "IMU, bússola,\nbarômetro, GNSS" {class: no; icon: https://icons.terrastruct.com/aws%2FInternet%20of%20Things%2FIoT_Sensor_light-bg.svg}
  rc: "Receptor de\nrádio controle" {class: no; icon: https://icons.terrastruct.com/tech%2F041-joystick.svg}
  esc: "ESCs e motores" {class: no; icon: https://icons.terrastruct.com/tech%2F009-cooler.svg}
}

hw.imu -> fc.entrada: "1" {class: sinc}
fc.entrada -> fc.uorb: "2" {class: assinc}
fc.uorb <-> fc.ekf2: "3, 4" {class: assinc}
fc.uorb <-> fc.ctrl: "5, 6" {class: assinc}
fc.uorb -> fc.saida: "7" {class: assinc}
fc.saida -> hw.esc: "8" {class: sinc}
fc.uorb -> fc.mavlink: "9" {class: assinc}
fc.mavlink -> meio.enlace.radio: "10" {class: assinc}
meio.enlace.radio -> solo.qgc: "11" {class: assinc}
fc.uorb <-> fc.dds: "12" {class: assinc}
fc.dds <-> meio.missao.agente: "13" {class: assinc}
meio.missao.agente <-> meio.missao.ros: "14" {class: assinc}
hw.rc -> fc.entrada {class: apoio}
fc.uorb -> fc.logger {class: apoio}
fc.logger -> fc.sd {class: apoio}
