# Nextcloud a 100.000 pés: diagrama de contexto final (C4, nível 1) (Figura 3.5.5).
# Diagrama de contexto: pessoas à esquerda, o sistema no centro, sistemas externos à direita.
# Convenção do livro: linha contínua = síncrona; tracejada = assíncrona.
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

grid-columns: 3
grid-gap: 320

classes: {
  sinc: {style: {stroke: "#1A2E4A"; stroke-width: 2; font-size: 16}}
  assinc: {style: {stroke: "#0F7A8C"; stroke-width: 2; stroke-dash: 5; font-size: 16}}
  apoio: {style: {stroke: "#9FB0C4"; stroke-width: 2}}
  faixa: {style: {fill: "#F4F6F9"; stroke: "#2A4468"; border-radius: 10; font-size: 20; bold: true}}
  livre: {label: ""; style: {fill: transparent; stroke: transparent}}
  vazio: {label: ""; width: 300; height: 330; style: {fill: transparent; stroke: transparent}}
  pessoa: {shape: image; style.font-size: 17}
  sistema: {width: 300; height: 200; label.near: top-center; icon.near: bottom-center; style: {fill: "#1A2E4A"; stroke: "#1A2E4A"; font-color: "#FFFFFF"; font-size: 20; bold: true; border-radius: 10}}
  externo: {width: 250; height: 130; label.near: top-center; icon.near: bottom-center; style: {fill: "#FFFFFF"; stroke: "#2A4468"; font-size: 17; border-radius: 6}}
}

pessoas: "Pessoas" {
  class: faixa
  grid-rows: 3
  vertical-gap: 150
  usuario: "Pessoa da universidade\nnavegador, cliente desktop, app móvel" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F359-users.svg}
  ti: "Equipe de TI\ninstala, atualiza, configura apps" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F204-settings.svg}
  encarregado: "Encarregado de dados" {class: pessoa; icon: https://icons.terrastruct.com/essentials%2F001-analytics.svg}
}

centro: {
  class: livre
  grid-rows: 3
  grid-gap: 0
  topo: {class: vazio; height: 555}
  nc: "Instalação Nextcloud\narquivos, compartilhamento, colaboração" {class: sistema; width: 400; icon: https://icons.terrastruct.com/dev%2Fphp.svg}
  base: {class: vazio; height: 520}
}

externos: "Sistemas externos" {
  class: faixa
  grid-rows: 7
  vertical-gap: 50
  ldap: "Diretório institucional\nLDAP" {class: externo; icon: https://icons.terrastruct.com/aws%2FSecurity%2C%20Identity%2C%20%26%20Compliance%2FAWS-Directory-Service.svg}
  ext: "Armazenamentos externos\nSMB, SFTP, S3, WebDAV" {class: externo; icon: https://icons.terrastruct.com/aws%2FStorage%2FAWS-Storage-Gateway.svg}
  obj: "Armazenamento de objetos\narmazenamento primário" {class: externo; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg}
  fed: "Outras instalações Nextcloud\ncompartilhamento federado" {class: externo; icon: https://icons.terrastruct.com/essentials%2F092-network.svg}
  mail: "Servidor de e-mail" {class: externo; icon: https://icons.terrastruct.com/aws%2FCustomer%20Engagement%2FAmazon-Simple-Email-Service-SES.svg}
  doc: "Servidor de documentos\nedição no navegador" {class: externo; icon: https://icons.terrastruct.com/essentials%2F263-notepad.svg}
  store: "Loja de apps" {class: externo; icon: https://icons.terrastruct.com/infra%2F025-plug-in.svg}
}

pessoas.usuario -> centro.nc: "WebDAV / HTTPS" {class: sinc}
pessoas.ti -> centro.nc: "interface web, linha de comando" {class: sinc}
pessoas.encarregado -> centro.nc: "relatórios de auditoria" {class: sinc}
centro.nc -> externos.ldap: "autentica usuários" {class: sinc}
centro.nc -> externos.ext: "monta pastas" {class: sinc}
centro.nc -> externos.obj: "grava conteúdo" {class: sinc}
centro.nc -> externos.mail: "notificações" {class: sinc}
centro.nc -> externos.doc: "edição colaborativa" {class: sinc}
centro.nc -> externos.store: "instala apps" {class: sinc}
centro.nc <-> externos.fed: "federação" {class: sinc}
